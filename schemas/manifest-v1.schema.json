{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ValanceX/Mesh/main/schemas/manifest-v1.schema.json",
  "title": "MESH component manifest, version 1",
  "description": "The components and named types an MPRX template is checked against. `mesh check --model` also enforces rules JSON Schema can't express: no duplicate keys or parameter names, every named reference resolves, no recursive named types, and no optional type wraps another, even through a named type.",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "types": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/type" }
    },
    "context": {
      "description": "The context channel: names a host supplies beside the snapshot, each with its type (no snippet). A component reads one only if its `uses` lists it; nothing is in scope implicitly. Optional; since 0.18.0.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/type" }
    },
    "components": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/tagName" },
      "additionalProperties": { "$ref": "#/$defs/component" }
    }
  },
  "required": ["version", "types", "components"],
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "description": "An MPRX identifier: not `true`, `false` or `null`, which MPRX reads as literals.",
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "not": { "enum": ["true", "false", "null"] }
    },
    "tagName": {
      "description": "An MPRX tag name.",
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
    },
    "component": {
      "type": "object",
      "properties": {
        "props": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/prop" }
        },
        "events": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/event" }
        },
        "commands": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/command" }
        },
        "scope": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/type" }
        },
        "unit": { "$ref": "#/$defs/unit" },
        "uses": {
          "description": "The names of the manifest's `context` this component reads. Each joins its scope (read-only) with the context's type. A name the `context` doesn't declare is an error (`manifest-unknown-context`), as is one that is also a prop or a scope name of the component, or listed twice (`manifest-context-clash`). Since 0.18.0.",
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" }
        }
      },
      "required": ["props", "events", "commands", "scope"],
      "additionalProperties": false
    },
    "unit": {
      "description": "The state and commands that belong to one occurrence of a composite, held by the host per occurrence and not part of the snapshot. Its state names join the component's scope (read-only) and its commands join the component's commands; a name that is already a scope name or a command is an error (`manifest-unit-clash`). A state field may share a prop's name only if it is `controllable` and the prop is optional and of the same type: the prop, when written, is then the value.",
      "type": "object",
      "properties": {
        "state": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": { "$ref": "#/$defs/type" },
              "default": {},
              "controllable": { "type": "boolean" }
            },
            "required": ["type", "default"],
            "additionalProperties": false
          }
        },
        "commands": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/command" }
        }
      },
      "additionalProperties": false
    },
    "field": {
      "description": "A prop or record field: its type, and whether it must be supplied.",
      "type": "object",
      "properties": {
        "type": { "$ref": "#/$defs/type" },
        "required": { "type": "boolean" }
      },
      "required": ["type", "required"],
      "additionalProperties": false
    },
    "prop": {
      "description": "A prop: a field that may also have a default, the value an unwritten prop binds in a composite. It must fit the prop's type (the loader checks that).",
      "type": "object",
      "properties": {
        "type": { "$ref": "#/$defs/type" },
        "required": { "type": "boolean" },
        "default": {}
      },
      "required": ["type", "required"],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "payload": { "$ref": "#/$defs/type" }
      },
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "properties": {
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "$ref": "#/$defs/identifier" },
              "type": { "$ref": "#/$defs/type" }
            },
            "required": ["name", "type"],
            "additionalProperties": false
          }
        },
        "effect": {
          "enum": ["read", "write", "destructive"],
          "description": "What the command does to the application's data (decision G13): a host reads it to decide whether to ask a person before it runs a command a generated screen asked for. An annotation: it changes nothing in how a template is checked or rendered."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "What to call the command to a person, in the prompt a host shows before a command that changes data."
        }
      },
      "required": ["parameters"],
      "additionalProperties": false
    },
    "type": {
      "type": "object",
      "required": ["kind"],
      "oneOf": [
        {
          "properties": { "kind": { "enum": ["string", "number", "boolean", "null", "any"] } },
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "list" },
            "element": { "$ref": "#/$defs/type" }
          },
          "required": ["element"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "record" },
            "fields": {
              "type": "object",
              "propertyNames": { "$ref": "#/$defs/identifier" },
              "additionalProperties": { "$ref": "#/$defs/field" }
            }
          },
          "required": ["fields"],
          "additionalProperties": false
        },
        {
          "description": "A string that is one of its values: 1 to 256 distinct ones (the loader checks the count and the distinctness).",
          "properties": {
            "kind": { "const": "enum" },
            "values": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          },
          "required": ["values"],
          "additionalProperties": false
        },
        {
          "description": "A piece of template with ordered parameters: only a component's prop or scope name may have this type (the loader checks the placement). A prop named `children` is a snippet with no parameters.",
          "properties": {
            "kind": { "const": "snippet" },
            "params": { "type": "array", "items": { "$ref": "#/$defs/type" } }
          },
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "named" },
            "name": { "type": "string" }
          },
          "required": ["name"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "optional" },
            "type": { "$ref": "#/$defs/type" }
          },
          "required": ["type"],
          "additionalProperties": false
        }
      ]
    }
  }
}
