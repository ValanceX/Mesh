{
  "$schema": "../../../schemas/manifest-v1.schema.json",
  "version": 1,
  "types": {
    "User": {
      "kind": "record",
      "fields": {
        "name": { "type": { "kind": "string" }, "required": true },
        "avatar": { "type": { "kind": "string" }, "required": false },
        "active": { "type": { "kind": "boolean" }, "required": true }
      }
    },
    "Layout": {
      "kind": "record",
      "fields": {
        "compact": { "type": { "kind": "boolean" }, "required": false }
      }
    }
  },
  "components": {
    "page": {
      "props": {
        "title": { "type": { "kind": "string" }, "required": true }
      },
      "events": {},
      "commands": {},
      "scope": {}
    },
    "text": {
      "props": {},
      "events": {},
      "commands": {},
      "scope": {}
    },
    "avatar": {
      "props": {
        "src": { "type": { "kind": "optional", "type": { "kind": "string" } }, "required": true },
        "size": { "type": { "kind": "string" }, "required": false }
      },
      "events": {},
      "commands": {},
      "scope": {}
    },
    "button": {
      "props": {
        "disabled": { "type": { "kind": "boolean" }, "required": false }
      },
      "events": {
        "click": { "payload": { "kind": "any" } },
        "press": {}
      },
      "commands": {},
      "scope": {}
    },
    "input": {
      "props": {
        "value": { "type": { "kind": "string" }, "required": false }
      },
      "events": {
        "change": { "payload": { "kind": "string" } }
      },
      "commands": {},
      "scope": {}
    },
    "compact-required": {
      "props": {
        "compact": { "type": { "kind": "optional", "type": { "kind": "boolean" } }, "required": true }
      },
      "events": {},
      "commands": {},
      "scope": {}
    },
    "compact-optional": {
      "props": {
        "compact": { "type": { "kind": "optional", "type": { "kind": "boolean" } }, "required": false }
      },
      "events": {},
      "commands": {},
      "scope": {}
    },
    "compact-strict": {
      "props": {
        "compact": { "type": { "kind": "boolean" }, "required": false }
      },
      "events": {},
      "commands": {},
      "scope": {}
    },
    "probe": {
      "props": {
        "str": { "type": { "kind": "string" }, "required": false },
        "maybeStr": { "type": { "kind": "optional", "type": { "kind": "string" } }, "required": false },
        "anything": { "type": { "kind": "any" }, "required": false },
        "maybeAnything": { "type": { "kind": "optional", "type": { "kind": "any" } }, "required": false },
        "num": { "type": { "kind": "number" }, "required": false },
        "flag": { "type": { "kind": "boolean" }, "required": false },
        "none": { "type": { "kind": "null" }, "required": false },
        "strings": { "type": { "kind": "list", "element": { "kind": "string" } }, "required": false },
        "users": { "type": { "kind": "list", "element": { "kind": "named", "name": "User" } }, "required": false },
        "user": { "type": { "kind": "named", "name": "User" }, "required": false },
        "point": {
          "type": {
            "kind": "record",
            "fields": {
              "x": { "type": { "kind": "number" }, "required": true },
              "y": { "type": { "kind": "number" }, "required": true },
              "label": { "type": { "kind": "string" }, "required": false },
              "note": { "type": { "kind": "optional", "type": { "kind": "string" } }, "required": true }
            }
          },
          "required": false
        }
      },
      "events": {},
      "commands": {},
      "scope": {}
    },
    "template": {
      "props": {},
      "events": {},
      "commands": {
        "save": { "parameters": [] },
        "select": {
          "parameters": [{ "name": "user", "type": { "kind": "named", "name": "User" } }]
        },
        "setCount": {
          "parameters": [{ "name": "count", "type": { "kind": "number" } }]
        }
      },
      "scope": {
        "user": { "kind": "named", "name": "User" },
        "maybeUser": { "kind": "optional", "type": { "kind": "named", "name": "User" } },
        "users": { "kind": "list", "element": { "kind": "named", "name": "User" } },
        "layout": { "kind": "named", "name": "Layout" },
        "name": { "kind": "string" },
        "maybeName": { "kind": "optional", "type": { "kind": "string" } },
        "count": { "kind": "number" },
        "flag": { "kind": "boolean" },
        "maybeFlag": { "kind": "optional", "type": { "kind": "boolean" } },
        "anything": { "kind": "any" },
        "maybeAnything": { "kind": "optional", "type": { "kind": "any" } }
      }
    }
  }
}
