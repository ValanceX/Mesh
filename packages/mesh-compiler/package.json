{
  "name": "@valancex/mesh-compiler",
  "version": "0.5.0",
  "description": "The MESH compiler, built for WebAssembly: checks MPRX against a component manifest and returns its diagnostics.",
  "type": "module",
  "license": "MIT",
  "author": "Jack Miller <jackmiller0899@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ValanceX/Mesh.git",
    "directory": "packages/mesh-compiler"
  },
  "keywords": [
    "mesh",
    "mprx",
    "valancex",
    "compiler",
    "webassembly"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mesh.wasm": "./dist/mesh.wasm",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "dist/mesh.wasm"
  ],
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-concurrency=1 \"test/*.test.mjs\""
  }
}
