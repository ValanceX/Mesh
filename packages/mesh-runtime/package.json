{
  "name": "@valancex/mesh-runtime",
  "version": "0.4.0",
  "description": "The MESH runtime, built for WebAssembly: renders a program of MESH templates against a snapshot, and turns events into command intents.",
  "type": "module",
  "license": "MIT",
  "author": "Jack Miller <jackmiller0899@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ValanceX/Mesh.git",
    "directory": "packages/mesh-runtime"
  },
  "keywords": [
    "mesh",
    "mprx",
    "valancex",
    "runtime",
    "webassembly"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mesh-runtime.wasm": "./dist/mesh-runtime.wasm",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "dist/mesh-runtime.wasm"
  ],
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-concurrency=1 \"test/*.test.mjs\""
  }
}
