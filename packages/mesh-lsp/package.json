{
  "name": "@valancex/mesh-lsp",
  "version": "0.5.0",
  "description": "Starts the native mesh-lsp language server for your platform. All language semantics live in the Rust binary.",
  "type": "module",
  "license": "MIT",
  "author": "Jack Miller <jackmiller0899@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ValanceX/Mesh.git",
    "directory": "packages/mesh-lsp"
  },
  "keywords": [
    "mesh",
    "mprx",
    "valancex",
    "language-server",
    "lsp"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "mesh-lsp": "dist/cli.js"
  },
  "files": [
    "dist/*.js"
  ],
  "optionalDependencies": {
    "@valancex/mesh-lsp-darwin-arm64": "0.5.0",
    "@valancex/mesh-lsp-darwin-x64": "0.5.0",
    "@valancex/mesh-lsp-linux-arm64": "0.5.0",
    "@valancex/mesh-lsp-linux-x64": "0.5.0",
    "@valancex/mesh-lsp-win32-x64": "0.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-concurrency=1 \"test/*.test.mjs\""
  }
}
