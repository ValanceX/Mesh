{
  "name": "mprx-vscode",
  "displayName": "MPRX",
  "description": "The MPRX language for VS Code: syntax highlighting and bracket rules. Diagnostics, hover and completion come from mesh-lsp (docs/guides/editor-setup.md); a framework extension wires them.",
  "version": "0.10.0",
  "private": true,
  "license": "MIT",
  "publisher": "valancex",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [{ "id": "mprx", "aliases": ["MPRX"], "extensions": [".mprx"], "configuration": "./language-configuration.json" }],
    "grammars": [{ "language": "mprx", "scopeName": "source.mprx", "path": "./syntaxes/mprx.tmLanguage.json" }]
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"test/*.test.mjs\""
  },
  "devDependencies": {
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
