{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "mprx",
      "camelcase": "Mprx",
      "title": "Mprx",
      "scope": "source.mprx",
      "file-types": [
        "mprx"
      ],
      "injection-regex": "^mprx$",
      "class-name": "TreeSitterMprx"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Mprx grammar for tree-sitter",
    "authors": [
      {
        "name": "Jack Miller",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-mprx",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}