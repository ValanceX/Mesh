{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "mprx",
      "camelcase": "Mprx",
      "title": "Mprx",
      "scope": "source.mprx",
      "file-types": [
        "mprx"
      ],
      "injection-regex": "^mprx$",
      "highlights": "queries/highlights.scm",
      "class-name": "TreeSitterMprx"
    }
  ],
  "metadata": {
    "version": "0.5.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for MPRX, the MESH UI language: parsing for mesh-parser, and highlighting queries for editors",
    "authors": [
      {
        "name": "Jack Miller",
        "email": "jackmiller0899@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/ValanceX/Mesh"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}